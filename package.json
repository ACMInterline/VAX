{
  "name": "vax-foundation",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:staging": "tsx src/operations/run-staging-development.ts",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:check": "drizzle-kit check",
    "db:migrate": "tsx --tsconfig tsconfig.server-scripts.json src/db/migrate.ts",
    "db:migrate:staging": "tsx --tsconfig tsconfig.server-scripts.json src/db/migrate-staging.ts",
    "db:provision-roles": "tsx src/db/provision-database-roles.ts",
    "db:rehearse-staging-rebuild": "tsx --tsconfig tsconfig.server-scripts.json src/db/rehearse-staging-rebuild.ts",
    "db:rotate-staging-credentials": "tsx src/db/rotate-staging-database-credentials.ts",
    "db:verify-security": "tsx src/db/verify-database-security.ts",
    "db:verify-security:staging": "tsx src/db/verify-staging-database-security.ts",
    "db:verify-state:staging": "tsx src/db/verify-staging-state.ts",
    "authority:activate:attelier:staging": "tsx --tsconfig tsconfig.server-scripts.json src/db/run-attelier-staging-authority.ts",
    "auth:bootstrap-owner": "tsx src/db/bootstrap-owner.ts",
    "auth:bootstrap-owner:staging": "tsx src/db/bootstrap-owner-staging.ts",
    "validate": "npm run lint && npm run typecheck && npm run test && npm run build && npm run db:check && npm audit && git diff --check"
  },
  "dependencies": {
    "@neondatabase/auth": "0.5.0-beta",
    "@neondatabase/serverless": "^1.1.0",
    "@next/env": "16.3.3",
    "drizzle-orm": "^0.45.2",
    "next": "16.3.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.10",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.3.3",
    "pg": "^8.23.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.12",
    "typescript": "^5",
    "vitest": "^4.1.11"
  },
  "overrides": {
    "@esbuild-kit/core-utils": {
      "esbuild": "^0.25.12"
    }
  }
}
